# WovenHaat — environment template.
# Copy to .env.local and fill in. Only VITE_* prefixes reach the client bundle,
# so never put a secret here.
#
# Contact page enquiry form (src/components/contact/EnquiryForm.jsx).
# POSTs JSON: { name, email, phone, type, quantity, message, source }.
# Leave blank to keep the form in demo mode (validates, shows success, sends nothing).
VITE_FORM_ENDPOINT=

# Newsletter subscribe (src/components/sections/Newsletter.jsx).
# POSTs JSON: { email, source }. Leave blank for demo mode.
VITE_NEWSLETTER_ENDPOINT=
